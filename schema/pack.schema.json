{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pack.schema.json",
  "title": "Kazna Pack",
  "type": "object",
  "required": ["id", "version", "type", "name"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "version": { "type": "integer", "minimum": 1 },
    "type": { "type": "string", "enum": ["payees", "banks", "categories", "mixed"] },
    "name": { "$ref": "#/$defs/localizedString" },
    "payees": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "name", "logo"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "$ref": "#/$defs/localizedString" },
          "logo": { "type": "string" },
          "mcc": { "type": "array", "items": { "type": "integer" } },
          "website": { "type": "string", "format": "uri" }
        }
      }
    },
    "banks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "name", "logo"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "$ref": "#/$defs/localizedString" },
          "logo": { "type": "string" },
          "country": { "type": "string" },
          "website": { "type": "string", "format": "uri" }
        }
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "name", "symbol"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "name": { "$ref": "#/$defs/localizedString" },
          "symbol": { "type": "string" },
          "parent_key": { "type": "string" },
          "mcc": { "type": "array", "items": { "type": "integer" } }
        }
      }
    }
  },
  "$defs": {
    "localizedString": {
      "type": "object",
      "required": ["en"],
      "properties": {
        "en": { "type": "string" },
        "ru": { "type": "string" }
      }
    }
  }
}
